

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | TamToum</title>

    <meta name="description"
          content="TamToum — Software development, digital products and selected projects." />

    <meta name="theme-color" content="#101D32" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Footer.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/css/portfolio-gallery.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/whatwebuildcss.css"
          asp-append-version="true" />


    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@ViewData["BodyClass"]">

    <header class="site-header">
        <nav class="navbar">
            <div class="container nav-container">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="logo">
                    Tam<span>Toum</span><i>.</i>
                </a>


                <div class="nav-links">
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="portfolio">WORK</a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="about">ABOUT</a>

                    <a asp-controller="Services"
                       asp-action="WebsiteDevelopment">
                        Services
                    </a>
                </div>

            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <!-- ==========================================
          FOOTER
     ========================================== -->

    <footer class="site-footer">

        <div class="footer-container">

            <!-- FOOTER TOP -->
            <div class="footer-top">

                <!-- BRAND -->
                <div class="footer-brand">

                    <a href="#home" class="footer-logo">
                        Tam<span>Toum</span>
                    </a>

                    <p class="footer-description">
                        Custom software development and modern web solutions
                        designed to help businesses grow, simplify their work,
                        and build a stronger digital presence.
                    </p>

                    <!-- Remote Badge -->
                    <div class="footer-remote">
                        <span class="remote-dot"></span>
                        Available Worldwide · Remote
                    </div>

                </div>


                <!-- QUICK LINKS -->
                <div class="footer-column">

                    <h4>Explore</h4>

                    <ul>
                        <li>
                            <a href="#home">Home</a>
                        </li>
@* 
                        <li>
                            <a href="#services">Services</a>
                        </li> *@

                        <li>
                            <a href="#portfolio">Portfolio</a>
                        </li>

                        <li>
                            <a href="#about">About</a>
                        </li>
                    </ul>

                </div>

                <!-- SERVICES -->
                <div class="footer-column">

                    <h4>Services</h4>

                    <ul>
                        <li>
                            <a asp-controller="Services"
                               asp-action="WebsiteDevelopment">
                                Website Development
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Services"
                               asp-action="EcommerceDevelopment">
                                E-commerce Development
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Services"
                               asp-action="WebApplications">
                                Web Applications
                            </a>
                        </li>

                     @*    <li>
                            <a asp-controller="Services"
                               asp-action="UIDesign">
                                UI/UX & Responsive Design
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Services"
                               asp-action="APIIntegrations">
                                API & Integrations
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Services"
                               asp-action="Maintenance">
                                Maintenance & Optimization
                            </a>
                        </li> *@
                    </ul>

                </div>

                <div class="footer-socials">

                    <!-- Instagram -->
                    <a href="https://www.instagram.com/tamtoumllc/" aria-label="Instagram" target="_blank">
                        <i class="bi bi-instagram"></i>
                    </a>

                    <!-- Facebook -->
                    <a href="https://www.facebook.com/profile.php?id=61594983231417" aria-label="Facebook" target="_blank">
                        <i class="bi bi-facebook"></i>
                    </a>

                    <!-- Threads -->
                    <a href="https://www.threads.com/?xmt=AQG0_GGaGJRLBag5n8Bm-PRNZWuNhuE5DhP7Bygfu6Ur84Q" aria-label="Threads" target="_blank">
                        <i class="bi bi-threads"></i>
                    </a>

                    <!-- LinkedIn -->
                    <a href="#" aria-label="LinkedIn" target="_blank">
                        <i class="bi bi-linkedin"></i>
                    </a>

                    <!-- GitHub -->
                    <a href="#" aria-label="GitHub" target="_blank">
                        <i class="bi bi-github"></i>
                    </a>

                </div>

            </div>

        </div>
@* 

            <!-- FOOTER CTA -->
            <div class="footer-cta">

                <div>
                    <span class="footer-cta-label">Have a project in mind?</span>

                    <h3>
                        Let's build something <span>great together.</span>
                    </h3>
                </div>

                <a href="#contact" class="footer-cta-button">
                    Start a Project
                    <i class="bi bi-arrow-up-right"></i>
                </a>

            </div> *@


            <!-- FOOTER BOTTOM -->
            <div class="footer-bottom">

                <p>
                    © 2026 TamToum. All rights reserved.
                </p>

                <div class="footer-bottom-links">

                    <a href="#">Privacy Policy</a>

                    <span></span>

                    <a href="#">Terms & Conditions</a>

                </div>

            </div>

        </div>

    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>




